# CodePulse Environment Variables
APP_NAME=CodePulse
APP_VERSION=1.0.0
DEBUG=false

# Persistence
DATABASE_URL=sqlite:///./codepulse.db
# For PostgreSQL: postgresql://postgres:postgres@localhost:5432/codepulse

# Authentication
SECRET_KEY=replace_with_a_secure_random_256bit_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Analysis Limits
MAX_CODE_SIZE_BYTES=500000
ANALYSIS_TIMEOUT_SECONDS=30
AI_ENABLED=false
OPENAI_API_KEY=
